<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>fairflip</ToolCommandName>
    <PackageId>fairflip</PackageId>
    <Version>1.0.0</Version>
    <Authors>CarbonNeuron</Authors>
    <Description>A command-line coin flipper with cryptographic and comparison strategies.</Description>
    <PackageTags>coin;flip;cli;dotnet-tool</PackageTags>
    <PackageProjectUrl>https://github.com/CarbonNeuron/fairflip</PackageProjectUrl>
    <RepositoryUrl>https://github.com/CarbonNeuron/fairflip</RepositoryUrl>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishAot>true</PublishAot>
    <StripSymbols>true</StripSymbols>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>FairFlip</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <None Include="LICENSE" Pack="true" PackagePath="/" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <!-- Keep all IFlipper implementations visible to reflection under AOT trimming -->
  <ItemGroup>
    <TrimmerRootAssembly Include="fairflip" />
  </ItemGroup>
</Project>
